# Cloudflare account identifier used to construct the R2 endpoint.
R2_ACCOUNT_ID=

# S3-compatible R2 API credentials. Never commit real values.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Read-only Cloudflare API token for R2 storage and operations metrics in the local UI.
# Permissions: Account Analytics Read and Workers R2 Storage Read.
CLOUDFLARE_API_TOKEN=

# Optional: set to "eu" only for an R2 bucket created in the EU jurisdiction.
R2_JURISDICTION=
