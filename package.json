{
  "name": "meta-catalog-image-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Batch product image renderer for Meta catalog supplementary feeds",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node src/cli.js validate",
    "inspect": "node src/cli.js inspect",
    "preview": "node src/cli.js preview",
    "render": "node src/cli.js render",
    "publish": "node --env-file-if-exists=.env src/cli.js publish",
    "publish:all": "node --env-file-if-exists=.env src/automation/run-all-clients.js",
    "ui": "node --env-file-if-exists=.env src/ui/server.js",
    "setup:u2net": "node scripts/setup-u2net.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@resvg/resvg-js": "^2.6.2",
    "fast-xml-parser": "^5.10.1",
    "satori": "^0.28.2",
    "sharp": "^0.35.3"
  }
}
